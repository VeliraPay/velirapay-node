{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "velirapay",
    "version": "0.1.0",
    "description": "The official Node.js library for VeliraPay crypto payments: charges, payment links, invoices, payouts, events and webhook verification.",
    "keywords": [
        "velirapay",
        "crypto",
        "payments",
        "payment-gateway",
        "bitcoin",
        "ethereum",
        "solana",
        "webhooks",
        "sdk",
        "api"
    ],
    "homepage": "https://velirapay.com",
    "bugs": {
        "url": "https://github.com/VeliraPay/velirapay-node/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/VeliraPay/velirapay-node.git"
    },
    "license": "MIT",
    "author": "VeliraPay (https://velirapay.com)",
    "type": "module",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/esm/index.d.ts",
                "default": "./dist/esm/index.js"
            },
            "require": {
                "types": "./dist/cjs/index.d.ts",
                "default": "./dist/cjs/index.js"
            }
        },
        "./package.json": "./package.json"
    },
    "main": "./dist/cjs/index.js",
    "types": "./dist/cjs/index.d.ts",
    "files": [
        "dist",
        "CHANGELOG.md"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "node scripts/build.js",
        "typecheck": "tsc --project tsconfig.json",
        "test": "npm run build && node --test \"test/**/*.test.ts\"",
        "check": "npm run typecheck && npm test",
        "prepack": "npm run build"
    },
    "devDependencies": {
        "@types/node": "^22.20.5",
        "typescript": "^7.0.2"
    }
}
